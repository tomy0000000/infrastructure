# Pinned to the patch line the Plausible CE compose file ships, the alpine variant it uses.
image:
  tag: 24.12.6.70-alpine

persistence:
  # Retain: an uninstall keeps the DO volume and the events in it.
  storageClass: do-block-storage-retain
  size: 5Gi

resources:
  requests:
    cpu: 100m
    memory: 512Mi
  limits:
    memory: 1Gi

# Plausible CE sets this: no user is written from env, the files below are the whole user config.
extraEnv:
  - name: CLICKHOUSE_SKIP_USER_SETUP
    value: "1"

# Plausible CE's tuning files, copied as is from its compose repo at the pinned release.
configFiles:
  ipv4-only.xml: |
    <clickhouse>
        <listen_host>0.0.0.0</listen_host>
    </clickhouse>
  logs.xml: |
    <clickhouse>
        <logger>
            <level>warning</level>
            <console>true</console>
        </logger>
    
        <query_log replace="1">
            <database>system</database>
            <table>query_log</table>
            <flush_interval_milliseconds>7500</flush_interval_milliseconds>
            <engine>
                ENGINE = MergeTree
                PARTITION BY event_date
                ORDER BY (event_time)
                TTL event_date + interval 30 day
                SETTINGS ttl_only_drop_parts=1
            </engine>
        </query_log>
    
        <!-- Stops unnecessary logging -->
        <metric_log remove="remove" />
        <asynchronous_metric_log remove="remove" />
        <query_thread_log remove="remove" />
        <text_log remove="remove" />
        <trace_log remove="remove" />
        <session_log remove="remove" />
        <part_log remove="remove" />
    </clickhouse>
  low-resources.xml: |
    <clickhouse>
        <!-- https://clickhouse.com/docs/en/operations/server-configuration-parameters/settings#mark_cache_size -->
        <mark_cache_size>524288000</mark_cache_size>
    </clickhouse>
usersFiles:
  default-profile-low-resources-overrides.xml: |
    <!-- https://clickhouse.com/docs/en/operations/tips#using-less-than-16gb-of-ram -->
    <clickhouse>
        <profiles>
            <default>
                <!-- https://clickhouse.com/docs/en/operations/settings/settings#max_threads -->
                <max_threads>1</max_threads>
                <!-- https://clickhouse.com/docs/en/operations/settings/settings#max_block_size -->
                <max_block_size>8192</max_block_size>
                <!-- https://clickhouse.com/docs/en/operations/settings/settings#max_download_threads -->
                <max_download_threads>1</max_download_threads>
                <!--
                https://clickhouse.com/docs/en/operations/settings/settings#input_format_parallel_parsing -->
                <input_format_parallel_parsing>0</input_format_parallel_parsing>
                <!--
                https://clickhouse.com/docs/en/operations/settings/settings#output_format_parallel_formatting -->
                <output_format_parallel_formatting>0</output_format_parallel_formatting>
            </default>
        </profiles>
    </clickhouse>

# Daily full backup of the events into R2, pruned by the bucket's lifecycle rule.
# Each run lands in <bucket>/plausible_events_db/<UTC timestamp>.
backup:
  enabled: true
  schedule: "0 3 * * *"
  url: https://{{ requiredEnv "TF_VAR_cloudflare_account_id" }}.r2.cloudflarestorage.com/{{ .Values.buckets.clickhouse.name }}
  databases:
    - plausible_events_db
  existingSecret: r2-backup
  # Folder to restore when the release is first installed. Empty starts empty.
  recoverFrom: ""

extraObjects:
  - apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      name: r2-backup
    spec:
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: onepassword
      target:
        name: r2-backup
        creationPolicy: Owner
      data:
        - secretKey: accessKeyId
          remoteRef:
            key: {{ dig "kubernetes" "name" "" .Values }}-cloudflare-clickhouse_backup/username
        - secretKey: secretAccessKey
          remoteRef:
            key: {{ dig "kubernetes" "name" "" .Values }}-cloudflare-clickhouse_backup/credential
