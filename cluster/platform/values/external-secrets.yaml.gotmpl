resources:
  requests:
    cpu: 20m
    memory: 64Mi
webhook:
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
certController:
  resources:
    requests:
      cpu: 10m
      memory: 32Mi

# The one secret that reaches the cluster by a path other than ESO, from
# instance/<env>.env like the provider tokens.
extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: onepassword-service-account
      namespace: external-secrets
    stringData:
      token: {{ requiredEnv "ONE_PASSWORD_ESO_SERVICE_ACCOUNT_TOKEN" | quote }}
